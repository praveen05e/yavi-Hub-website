# Database
DATABASE_URL=postgresql://yaavi_user:yaavi_pass@localhost:5432/yaavi_db

# AI provider (abstracted - see app/ai/provider.py)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
